  m_Script: {fileID: 11500000, guid: 24feb1ea25740a04fa41f42ad2956c32, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionText: "The files are piled up into mountains. Sifting through the papers,
    there is a letter buried at the very bottom \u2014 almost missed entirely...[next]It\u2019s
    from the police. Dated nearly half a year ago...[next]It mentions the ongoing
    investigation into Mom\u2019s death... and the fire. It ends with a request:
    [next]if anyone in the family knows where Ed is, they should contact the authorities
    immediately."
  dialogBox: {fileID: 332366804}
  dialogText: {fileID: 1684149971}
